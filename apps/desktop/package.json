{
  "name": "@kemix/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Trae tus playlists de Spotify, YouTube Music, Qobuz y Deezer y descárgalas en FLAC",
  "author": "Vynzk",
  "homepage": "https://github.com/vynzk/kemix",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@kemix/core": "*",
    "@kemix/server": "*",
    "lucida": "2.0.0-54",
    "node-taglib-sharp": "^6.0.3",
    "youtubei.js": "^18.3.0",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0"
  },
  "build": {
    "appId": "app.kemix.desktop",
    "productName": "Kemix",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../../packages/ui/dist",
        "to": "ui"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "executableName": "kemix",
      "category": "Audio",
      "maintainer": "Vynzk",
      "synopsis": "Playlists de Spotify, YouTube Music, Qobuz y Deezer en FLAC",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "deb": {
      "packageName": "kemix"
    }
  }
}
