{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs",
            "timeout": 60,
            "statusMessage": "Lint + typecheck…"
          }
        ]
      }
    ]
  }
}
